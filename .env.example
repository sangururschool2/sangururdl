# ==============================================================================
# Sangurur Digital Learner Register (SDLR) - Environment Variables Example
# ==============================================================================
# Copy to .env for local testing (never commit .env files with secrets).
# On Netlify: configure these in Site configuration -> Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Firebase Client Configuration (Publicly bundled by Vite into dist/)
# Obtain these exact values from Firebase Console -> Project settings -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# Server-Side / Netlify Functions Variables (KEEP SECRET - NEVER PREFIX WITH VITE_)
# ------------------------------------------------------------------------------

# Required in production: strong random 32+ character hex secret used to sign
# HMAC-SHA256 staff & learner session tokens across serverless invocations.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Initial bootstrap password for the default staff teacher account ("Teacher").
# Only used if teacherCredentials/teacher_default_staff has not been created yet.
DEFAULT_TEACHER_PASSWORD=""

# Required in production under hardened Firestore rules:
# Full single-line Firebase Admin service account JSON for project clever-hangar-wwpgt
# (Firebase Console -> Project settings -> Service accounts -> Generate new private key).
# Enables teacher/learner credential verification, Firebase custom token minting, and privileged writes.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Public canonical site URL (used for callbacks/reference if configured)
APP_URL=""

# Optional Gemini API key (server-side only, if AI endpoints are enabled)
GEMINI_API_KEY=""
